# Copy to .env for local development. On Render these are set in the dashboard.

# The ONLY thing that changes between deployment phases.
#   Phase A (Turso):  libsql://<database>-<org>.turso.io
#   Phase B (local):  file:./data/app.db
DATABASE_URL=file:./data/app.db

# Required for Turso only; leave empty for a local file database.
DATABASE_AUTH_TOKEN=

# Render injects PORT itself; 3000 is the local default.
PORT=3000

# Optional CORS allowlist, comma separated. Empty = allow any origin.
# e.g. ALLOWED_ORIGINS=https://task-tracker.pages.dev
ALLOWED_ORIGINS=

# Optional. Enables "AI bulk add" on the Upcoming page, which turns pasted notes
# into a reviewable list of tasks. Free key from https://console.groq.com/keys
# Leave empty and the button simply does not appear; nothing else is affected.
GROQ_API_KEY=

# Optional override. Defaults to llama-3.3-70b-versatile. If that model is not
# available to your key, the server asks the API which one is and retries.
GROQ_MODEL=
